{
  "name": "momo-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --environment node --dir src",
    "test:coverage": "vitest run --environment node --dir src --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.545.0",
    "next": "^16.3.6",
    "nodemailer": "^9.1.1",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^20.1.0",
    "react-easy-crop": "^6.2.3",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.0.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
